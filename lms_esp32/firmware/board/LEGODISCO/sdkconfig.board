# Speed: full CPU clock (MicroPython's default is 160 MHz) and 80 MHz flash,
# since Python and its VM run from flash through the cache.
#
# Flash stays in dual (DIO) mode, NOT quad (QIO). LMS-ESP32 v2 boards use the
# ESP32-PICO-V3-02, whose in-package flash has GPIO18 as one of its quad data
# lines; GPIO18 is also the LEGO port's RX, so in QIO mode lump.py setting it
# up cuts the chip off from its own flash (interrupt-watchdog reset loop).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_FREERTOS_HZ=1000

# Bluetooth for the iPad remote (after MicroPython's boards/sdkconfig.ble): one iPad at a time
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="GTAC arm"

# Wi-Fi is never turned on: the smallest buffers, so their RAM goes to Python and Bluetooth
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_IPV6=n
